{
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        "helpers:pinGitHubActionDigests",
        ":semanticCommits"
    ],
    "schedule": [
        "on saturday"
    ],
    "assignees": [
        "r4b2"
    ],
    "labels": [
        "dependencies"
    ],
    "semanticCommits": "enabled",
    "recreateWhen": "always",
    "separateMajorMinor": false,
    "packageRules": [
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "commitMessagePrefix": "chore(github-actions): ",
            "pinDigests": true,
            "labels": [
                "dependencies",
                "github-actions"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "groupName": "go",
            "commitMessagePrefix": "chore(go): ",
            "labels": [
                "dependencies",
                "go"
            ]
        }
    ]
}
